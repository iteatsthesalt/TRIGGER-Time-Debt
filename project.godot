; Engine configuration file.
; TRIGGER: Time Debt — HD-2D sequel to Chrono Trigger (Godot 4.7.2, Forward+).

config_version=5

[application]

config/name="TRIGGER: Time Debt"
config/description="A porcelain copy of Crono chases his daughter through the seven bad endings his victory buried."
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://assets/ui/icon.png"

[autoload]

Data="*res://scripts/autoload/data_registry.gd"
Flags="*res://scripts/autoload/possibility_engine.gd"
Game="*res://scripts/autoload/game_state.gd"
Saves="*res://scripts/autoload/save_system.gd"
Universe="*res://scripts/autoload/universe_switcher.gd"
Audio="*res://scripts/autoload/audio_director.gd"
Router="*res://scripts/autoload/scene_router.gd"
Story="*res://scripts/autoload/story_runner.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_call_argument=0

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1

[gui]

theme/custom="res://assets/ui/theme.tres"

